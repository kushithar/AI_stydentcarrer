# Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate for your environment.

# Flask Application Secret Key
SECRET_KEY=your-secure-random-secret-key-min-32-chars

# JWT Authentication Secret Key
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars
JWT_EXPIRE_HOURS=24

# Database Configuration
# Supported types: 'mysql' (default) or 'sqlite'
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_career_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Or provide explicit full database URL
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/student_career_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
